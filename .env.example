# ==============================================================================
# CRM Elevate Backend Environment Variables Template
# ==============================================================================

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/crm_db?schema=public"

# Server Configuration
PORT=5000
HOST="0.0.0.0"
# Local development; use production for deployed environments.
NODE_ENV="development"
# fatal, error, warn, info, debug, trace, or silent
LOG_LEVEL="info"

# Security & Authentication Secrets (Generate strong random 32+ char strings in production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"
COOKIE_SECRET="replace_with_a_secure_random_cookie_secret_in_production"

# Frontend & Backend URLs
FRONTEND_URL="https://willowycrm.vercel.app"
BACKEND_URL="https://crm-backend-ten-pi.vercel.app"

# Invoice email delivery (Resend)
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="Willowy CRM <billing@example.com>"

# Meta Lead Ads (optional; no credentials are committed)
# Set the same random verify token in Meta's webhook setup.
META_WEBHOOK_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""
# Explicit supported version shown by your Meta app, for example vXX.0.
META_GRAPH_API_VERSION=""
# Existing active CRM branch and user IDs. User is used for creation attribution.
META_DEFAULT_BRANCH_ID=""
META_INTEGRATION_USER_ID=""
# Optional existing assignee in the target branch; leave empty for unassigned leads.
META_DEFAULT_ASSIGNEE_ID=""
# Optional comma-separated Instant Form IDs; empty accepts all forms on META_PAGE_ID.
META_FORM_IDS=""
# Strong random bearer secret for the recovery worker (also used by Vercel Cron).
CRON_SECRET=""
